# ─────────────────────────────────────────────────────────────
# SkillPath AI – Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env or .env.local to version control.
# ─────────────────────────────────────────────────────────────

# ── Google Gemini API (server-side only) ─────────────────────
# Obtain a free key at: https://aistudio.google.com/app/apikey
# This variable is read EXCLUSIVELY by the Netlify serverless
# function (netlify/functions/gemini-chat.ts).
# It is NEVER sent to the browser or bundled by Vite.
GEMINI_API_KEY=your_gemini_api_key_here

# ── Gemini Model (optional) ───────────────────────────────────
# Default: gemini-1.5-flash  (fast, free-tier friendly)
# Other supported values: gemini-1.5-pro, gemini-2.0-flash-exp
GEMINI_MODEL=gemini-1.5-flash

# ── Legacy frontend key (kept for existing AI mentor features) ─
# Optional – the roadmap advisor and skill-explanation features
# can still use a client-side key stored in the student profile.
# VITE_GEMINI_API_KEY=your_key_here   ← NOT recommended for the chat assistant
